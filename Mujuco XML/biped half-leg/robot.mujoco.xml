<mujoco model="robot">
  <default>
    <default class="robot">
      <default class="motor">
        <joint />
        <motor />
      </default>
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom material="collision_material" condim="3" contype="0" conaffinity="1" priority="1" group="1" solref="0.005 1" solimp="0.99 0.999 1e-05" friction="1 0.01 0.01" />
      </default>
    </default>
  </default>

  <compiler angle="radian" />

  <asset>
    <material name="grey" rgba="0.5 0.5 0.5 1" />
    <material name="default_material" rgba="0.7 0.7 0.7 1" />
    <material name="collision_material" rgba="1.0 0.28 0.1 0.9" />
    <mesh name="base_link.step" file="meshes/base_link.step" />
    <mesh name="Hip_Left.step" file="meshes/Hip_Left.step" />
    <mesh name="Sartorius_Left_Upper.step" file="meshes/Sartorius_Left_Upper.step" />
    <mesh name="Knee_Left.step" file="meshes/Knee_Left.step" />
    <mesh name="Tendon_LT.step" file="meshes/Tendon_LT.step" />
  </asset>

  <worldbody>
    <body name="base_link" pos="0.00000000 0.00000000 0.09400000" quat="1 0 0 0" childclass="robot">
      <freejoint name="floating_base" />
      <geom name="base_link_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="box" size="0.05 0.05 0.05" class="collision" />
      <geom name="base_link_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="grey" type="mesh" mesh="base_link.step" scale="1 1 1" class="visual" />
      <body name="Hip_Left" pos="0.018 0.08 0" quat="1.0 0.0 0.0 0.0">
        <joint name="joint_Hip_Left" type="hinge" ref="0.0" class="motor" range="-3.141592653589793 3.141592653589793" axis="0 0 1" />
        <geom name="Hip_Left_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="box" size="0.05 0.05 0.05" class="collision" />
        <geom name="Hip_Left_visual" pos="-0.018000000000000006 -0.08 0" quat="1.0 0.0 0.0 0.0" material="grey" type="mesh" mesh="Hip_Left.step" scale="1 1 1" class="visual" />
        <body name="Sartorius_Left_Upper" pos="0.034 0.053 0" quat="1.0 0.0 0.0 0.0">
          <joint name="joint_Sartorius_Left_Upper" type="hinge" ref="0.0" class="motor" range="-3.141592653589793 3.141592653589793" axis="1 0 0" />
          <geom name="Sartorius_Left_Upper_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="box" size="0.05 0.05 0.05" class="collision" />
          <geom name="Sartorius_Left_Upper_visual" pos="-0.034 -0.053 0" quat="1.0 0.0 0.0 0.0" material="grey" type="mesh" mesh="Sartorius_Left_Upper.step" scale="1 1 1" class="visual" />
          <body name="Knee_Left" pos="0 0 0" quat="1.0 0.0 0.0 0.0">
            <joint name="joint_Knee_Left" type="hinge" ref="0.0" class="motor" range="-3.141592653589793 3.141592653589793" axis="1 0 0" />
            <geom name="Knee_Left_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="box" size="0.05 0.05 0.05" class="collision" />
            <geom name="Knee_Left_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="grey" type="mesh" mesh="Knee_Left.step" scale="1 1 1" class="visual" />
            <body name="Tendon_LT" pos="0.033 -0.024 -0.044" quat="1.0 0.0 0.0 0.0">
              <joint name="joint_Tendon_LT" type="hinge" ref="0.0" class="motor" range="-3.141592653589793 3.141592653589793" axis="1 0 0" />
              <geom name="Tendon_LT_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="box" size="0.05 0.05 0.05" class="collision" />
              <geom name="Tendon_LT_visual" pos="-0.033 0.024 0.044" quat="1.0 0.0 0.0 0.0" material="grey" type="mesh" mesh="Tendon_LT.step" scale="1 1 1" class="visual" />
            </body>
          </body>
        </body>
      </body>
      <site name="base_link_site" pos="0 0 0" quat="1 0 0 0" />
      <camera name="front_camera" mode="track" fovy="90.0" quat="4.329780281177467e-17 4.329780281177466e-17 0.7071067811865475 0.7071067811865476" pos="0.0 2.0 0.5" />
      <camera name="side_camera" mode="track" fovy="90.0" quat="-0.5 -0.4999999999999999 0.5 0.5000000000000001" pos="-2.0 0.0 0.5" />
    </body>
  </worldbody>

  <actuator>
    <motor name="joint_Hip_Left_ctrl" joint="joint_Hip_Left" class="motor" />
    <motor name="joint_Sartorius_Left_Upper_ctrl" joint="joint_Sartorius_Left_Upper" class="motor" />
    <motor name="joint_Knee_Left_ctrl" joint="joint_Knee_Left" class="motor" />
    <motor name="joint_Tendon_LT_ctrl" joint="joint_Tendon_LT" class="motor" />
  </actuator>

  <contact>
    <exclude body1="base_link" body2="Hip_Left" />
    <exclude body1="Hip_Left" body2="Sartorius_Left_Upper" />
    <exclude body1="Sartorius_Left_Upper" body2="Knee_Left" />
    <exclude body1="Knee_Left" body2="Tendon_LT" />
  </contact>

  <sensor>
    <framepos name="base_link_site_pos" objtype="site" objname="base_link_site" />
    <framequat name="base_link_site_quat" objtype="site" objname="base_link_site" />
    <framelinvel name="base_link_site_linvel" objtype="site" objname="base_link_site" />
    <frameangvel name="base_link_site_angvel" objtype="site" objname="base_link_site" />
    <velocimeter name="base_link_site_vel" site="base_link_site" />
  </sensor>
</mujoco>