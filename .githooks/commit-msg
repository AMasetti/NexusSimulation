#!/bin/sh
# Reject commits carrying AI-agent attribution (Claude, Copilot, Cursor, Codex, Aider, etc.)
agents='claude|anthropic|copilot|cursor|codex|openai|chatgpt|gemini|aider|devin|codeium|windsurf|\[bot\]'
pattern="co-authored-by:.*($agents|gpt-)|generated (with|by) .*($agents|ai)|claude\.(ai|com)/code|🤖"

if grep -v '^#' "$1" | grep -qiE "$pattern"; then
  echo "✖ commit rejected: AI agent attribution found in commit message:" >&2
  grep -v '^#' "$1" | grep -iE "$pattern" | while IFS= read -r l; do echo "    $l" >&2; done
  echo "  Remove those lines and commit again." >&2
  exit 1
fi

# Reject commits whose author or committer is an AI agent
for role in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${role}_IDENT" | sed 's/ [0-9]* [-+][0-9]*$//')
  if echo "$ident" | grep -qiE "$agents"; then
    echo "✖ commit rejected: $role is an AI agent: $ident" >&2
    echo "  Commit as yourself (git config user.name / user.email, or --author)." >&2
    exit 1
  fi
done

# Require Conventional Commits — the release workflow derives the semver bump from them
types='feat|fix|perf|refactor|chore|ci|docs|style|test|build|revert'
subject=$(grep -v '^#' "$1" | grep -m1 -v '^[[:space:]]*$')
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac
if ! echo "$subject" | grep -qE "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*"; then
  echo "✖ commit rejected: subject is not a Conventional Commit:" >&2
  echo "    $subject" >&2
  echo "  Use  <type>[(scope)][!]: <description>   e.g.  feat(sliders): add step buttons" >&2
  echo "  Types: $(echo "$types" | tr '|' ' ')" >&2
  echo "  feat → minor release · fix/perf/refactor → patch · '!' or BREAKING CHANGE: → major" >&2
  exit 1
fi
